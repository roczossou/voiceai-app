{
  "name": "backend",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "nodemon --env-file=.env --dns-result-order=ipv4first src/server.js",
    "start": "node --dns-result-order=ipv4first src/server.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "build:all": "npm install --prefix ../frontend && npm run build --prefix ../frontend && npm install --prefix ../widget && npm run build --prefix ../widget"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@google/genai": "^2.10.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "groq-sdk": "^1.3.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "msedge-tts": "^2.0.6",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "resend": "^6.17.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
