# ── Backend ──
DATABASE_URL="postgresql://...neon.tech/neondb?sslmode=require"
PORT=4000
NODE_ENV=development
FRONTEND_URL=https://localhost:5173
# Origines CORS supplémentaires, séparées par des virgules (ex: IP LAN du téléphone)
FRONTEND_URLS=https://localhost:5173,https://192.168.43.71:5173
JWT_SECRET=change_me_in_production
GEMINI_API_KEY=
# Clés de rotation Gemini supplémentaires (optionnel)
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
ANTHROPIC_API_KEY=
# 32 octets en hex (openssl rand -hex 32)
LLM_KEY_SECRET=
GROQ_API_KEY=
RESEND_API_KEY=
# Upstash Redis (REST) — console.upstash.com → base → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Frontend ──
# Laisser VIDE en dev local : le proxy Vite gère /api (HTTP + WS) en même origine.
# VITE_API_URL=https://api.tondomaine.com/api/v1
# VITE_WS_URL=wss://api.tondomaine.com   (si le backend est exposé séparément en wss)
